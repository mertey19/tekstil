# Public business number explicitly provided by the user. This is not a secret.
SITE_MODE=demo
SITE_PREVIEW=true
SITE_WHATSAPP=+905305482660
# Local/demo: leave empty. Vercel Production must use the Search Console
# property origin, not *.vercel.app, e.g. https://www.siliversilen.com
SITE_URL=
SITE_DOMAIN_VERIFIED=false
CONTENT_APPROVED=false

# Optional soft rate limiting by client IP. Set only when a trusted deployment
# proxy strips user-supplied values and overwrites this header. Otherwise shared.
TRUSTED_CLIENT_IP_HEADER=

# Vercel uses Neon. These connection strings must remain server-only secrets.
DATABASE_URL=
CMS_DATABASE_URL=
# Without a database URL, local development uses SQLite (Node.js 24+).
# Empty uses ./data. Never put this directory under public/.
CMS_DATA_DIR=
# HTTPS origin used to open the admin panel. Empty falls back to SITE_URL.
# Local development at localhost/127.0.0.1 is allowed without configuring this.
ADMIN_ORIGIN=
